apiVersion: v1
kind: Config
preferences: {}

clusters:
- name: default
  cluster:
    server: https://127.0.0.1:6443
    certificate-authority-data: DATA+OMITTED

users:
- name: default
  user:
    client-certificate-data: DATA+OMITTED
    client-key-data: DATA+OMITTED

contexts:
- name: default
  context:
    cluster: default
    user: default

current-context: default